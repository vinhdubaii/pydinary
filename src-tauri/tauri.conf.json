{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pydinary",
  "version": "0.1.0",
  "identifier": "com.laris.pydinary",
  "build": {
    "beforeDevCommand": "npm run gen-icons",
    "beforeBuildCommand": "npm run gen-icons",
    "frontendDist": "https://pydinary.pages.dev/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pydinary",
        "url": "https://pydinary.pages.dev/",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": false,
        "backgroundColor": "#0e0e0e",
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vinhdubaii/pydinary-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENDJDOEY4QkUxNDE2NkYKUldSdkZoUysrTWhDN1RuVDE2SHdwSUZQRGdZQWhPVnp0bkpTUkFBQ1JVaExnejFwOEZ3bGx0bVcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
